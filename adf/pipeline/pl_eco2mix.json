{
	"name": "pl_eco2mix",
	"properties": {
		"activities": [
			{
				"name": "copy_api_to_raw",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.10:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET",
							"requestTimeout": ""
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_eco2mix_api",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_raw_file",
						"type": "DatasetReference",
						"parameters": {
							"fileName": {
								"value": "@concat('eco2mix_', formatDateTime(utcNow(), 'yyyyMMddTHHmmss'), 'Z.json')",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"annotations": []
	}
}